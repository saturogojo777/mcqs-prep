# Public Supabase values (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose these to the client.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
ADMIN_ACCESS_KEY=
ADMIN_SESSION_SECRET=

# Canonical site URL: canonical tags, sitemap.xml, robots.txt, social cards.
NEXT_PUBLIC_SITE_URL=https://mcqs-prep-eta.vercel.app

# Optional. Leave empty and no ad slot renders anywhere.
NEXT_PUBLIC_ADSENSE_CLIENT=
